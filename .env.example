# Postgres connection string
DATABASE_URL=postgres://feeds:feeds@localhost:5432/feeds

# Which user's state the API and MCP server act on (single-user installs: leave at 1)
FEED_USER_ID=1

# REST API / web UI port
PORT=3000

# Optional bearer token protecting /api and /mcp. Leave empty for a trusted LAN/localhost.
# Required on Vercel: the deployment refuses API and MCP requests without it.
API_TOKEN=

# Bearer secret accepted by GET /api/cron/refresh (Vercel Cron sends it automatically).
CRON_SECRET=

# Max Postgres connections per process (default 10, or 3 on Vercel)
# PG_POOL_MAX=10

# Ingestion
INGEST_IN_PROCESS=true          # run the fetch scheduler inside the API process
FETCH_CRON=*/15 * * * *
FETCH_CONCURRENCY=4
FETCH_TIMEOUT_MS=20000
EXTRACT_FULL_ARTICLES=true      # run Readability on items whose feed only ships a teaser
EXTRACT_MIN_CHARS=600
# Imported bookmarks (Import bookmarks…): article text is fetched lazily, newest first
BOOKMARK_BATCH=40               # fetched per scheduled pass
BOOKMARK_BUDGET_MS=45000        # stop starting new fetches in a pass after this long
BOOKMARK_MAX_ATTEMPTS=3         # transient failures before a link is reported dead
BOOKMARK_RETRY_MINUTES=60       # wait before retrying a transient failure
# BOOKMARK_FETCH_ON_IMPORT=true # keep fetching in-process after an import (default off on Vercel)
# USER_AGENT=feed-reader/0.1 (+https://example.com)

# MCP
MCP_PORT=3001                   # only used by `npm run mcp -- --http`
MCP_RESOURCE_ITEM_CHARS=4000    # per-article text cap inside feed:// resources
