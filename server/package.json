{
  "name": "@feed-reader/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:api": "tsx watch src/api/index.ts",
    "start": "node dist/api/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "worker": "tsx src/ingest/worker.ts",
    "mcp": "tsx src/mcp/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@mozilla/readability": "^0.6.0",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
